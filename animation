local player = game.Players.LocalPlayer

local function applyAnimations(character)
	local animate = character:WaitForChild("Animate")

	-- Zombie Idle
	animate.idle.Animation1.AnimationId = "https://www.roblox.com/catalog/619535834/Zombie-Idle"
	animate.idle.Animation2.AnimationId = "https://www.roblox.com/catalog/619535834/Zombie-Idle"

	-- Mage Walk
	animate.walk.WalkAnim.AnimationId = "https://www.roblox.com/catalog/754636298/Mage-Walk"

	-- Zombie Run
	animate.run.RunAnim.AnimationId = "https://www.roblox.com/catalog/619536621/Zombie-Run"

	-- Oldschool Jump
	animate.jump.JumpAnim.AnimationId = "https://www.roblox.com/catalog/5319917561/Oldschool-Jump"

	-- Oldschool Fall
	animate.fall.FallAnim.AnimationId = "https://www.roblox.com/catalog/5319914476/Oldschool-Fall"

	-- Reload Animate
	animate.Disabled = true
	task.wait()
	animate.Disabled = false
end

if player.Character then
	applyAnimations(player.Character)
end

player.CharacterAdded:Connect(applyAnimations)
